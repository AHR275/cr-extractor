<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>app</groupId>
    <artifactId>crextractor</artifactId>
    <version>1.0.0</version>

    <packaging>pom</packaging>

    <name>CR Extractor</name>
    <description>Saudi Business Document Extraction Platform</description>

    <modules>
        <module>cr-core</module>
        <module>cr-desktop</module>
        <module>cr-cli</module>
    </modules>

    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Build with Java 25 -->
        <maven.compiler.release>25</maven.compiler.release>
        <java.version>25</java.version>

        <javafx.version>24</javafx.version>

        <jackson.version>2.20.0</jackson.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <jsoup.version>1.21.1</jsoup.version>
        <zxing.version>3.5.3</zxing.version>
        <playwright.version>1.55.0</playwright.version>
        <junit.version>5.13.4</junit.version>

    </properties>

    <build>

        <pluginManagement>

            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>

                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

            </plugins>

        </pluginManagement>

    </build>

</project>