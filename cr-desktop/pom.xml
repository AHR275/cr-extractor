<project xmlns="http://maven.apache.org/POM/4.0.0">

    <modelVersion>4.0.0</modelVersion>


    <parent>
        <groupId>app</groupId>
        <artifactId>crextractor</artifactId>
        <version>1.0.0</version>
    </parent>


    <artifactId>cr-desktop</artifactId>

    <dependencies>

        <dependency>
            <groupId>app</groupId>
            <artifactId>cr-core</artifactId>
            <version>1.0.0</version>
        </dependency>

            <dependency>
